modules = ["nodejs-24", "python-3.12", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "prediction-engine-invariants"

[[workflows.workflow]]
name = "prediction-engine-invariants"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/api-server && pnpm exec tsx --test $(find src/services/predictionEngine -name '*.test.ts') src/services/parlayBuilder/builderScoringService.test.ts src/services/tennisData/compositeProvider.tier5.test.ts && cd ../tennis-predictor && pnpm exec tsx --test src/lib/monteCarloHeadline.test.ts"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
AI_INTEGRATIONS_OPENAI_BASE_URL = "https://api.openai.com/v1"
RAPIDAPI_HOST = "tennis-api-atp-wta-itf.p.rapidapi.com"
PAYMENTS_PLAN_KEY = "pro"
PAYMENTS_PLAN_NAME = "Pro"
PAYMENTS_V2_ENABLED = "true"
VITE_PAYMENTS_V2_ENABLED = "true"
APP_PUBLIC_URL = "https://tennis-stats-engine.replit.app"
STRIPE_ELITE_PRICE_ID = "price_1TwuumGYBq3EbAKF6TIir0BU"
STRIPE_PRICE_ID = "price_1TwuteGYBq3EbAKFQb1xOqzy"
STRIPE_ELITE_ANNUAL_PRICE_ID = "price_1TwuwCGYBq3EbAKFKj19qVAw"
STRIPE_PRO_ANNUAL_PRICE_ID = "price_1Tx5jGGYBq3EbAKF3iDHIw52"
STRIPE_TEAM_PRICE_ID = "price_1TwuxDGYBq3EbAKFyjKklp3D"
ADMIN_ACCESS_KEY = "54321"

[userenv.development]
NODE_OPTIONS = "--max-old-space-size=6144"

[[ports]]
localPort = 3001
externalPort = 80
